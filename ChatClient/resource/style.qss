    padding: 0px;
    background-color: transparent; /* 或者你想要的深色 */
}

QLabel#selfInfoIdTag{
    color: #9e9e9e;
}

QLabel#selfInfoId{
    color: #9e9e9e;
}

QLabel#selfInfoNameShow{
    color: #161616;
    font-size: 15px;
}



QLineEdit#selfInfoTelVerifyCode,
QLineEdit#selfInfoTelEdit,
QLineEdit#selfInfoSignEdit,
QLineEdit#selfInfoNameEdit {
    border: 1px solid  rgb(225,225,225); /* 统一设为 1px 实线，浅灰色 */
    border-radius: 5px;        /*稍微加一点圆角更现代 */
    background-color: #FFFFFF; /* 纯白背景 */
    color: #333333;            /* 文字颜色 */
    padding-left: 8px;         /* 文字离左边稍微有点距离 */
    font-size: 13px;
}


/*MID*/

QLabel#selfInfoSignTag{color: #9e9e9e;}

QLabel#selfInfoSignShow{color: #9e9e9e;}







/*BOTTOM*/

QLabel#selfInfoTelTag{color: #9e9e9e;}

QLabel#selfInfoTelShow{color: #9e9e9e;}




QPushButton#selfInfoNameSubmitBtn,
QPushButton#selfInfoNameEditBtn,
QPushButton#selfInfoSignEditBtn,
QPushButton#selfInfoSubmitBtn,
QPushButton#selfInfoEditBtn,
QPushButton#selfInfoSubmitBtn{
    margin: 0px; 
    padding: 0px;
    background-size: 100% 100%;
    border-radius: 5px;
    outline: none; /* 再次确认去掉焦点虚线框 */
    min-width: 30px;  /* 🔥 强制给一个最小宽高，防止被布局挤压 */
    min-height: 30px;
    max-width: 30px;  /* 🔥 锁死最大宽高 */
    max-height: 30px;
    border:none; background:transparent;
}


QPushButton#selfInfoNameSubmitBtn:hover,
QPushButton#selfInfoNameEditBtn:hover,
QPushButton#selfInfoSignEditBtn:hover,
QPushButton#selfInfoSubmitBtn:hover,
QPushButton#selfInfoEditBtn:hover,
QPushButton#selfInfoSubmitBtn:hover{
background-color: #d7d7d7;
}


QPushButton#selfInfoNameSubmitBtn:pressed,
QPushButton#selfInfoNameEditBtn:pressed,
QPushButton#selfInfoSignEditBtn:pressed,
QPushButton#selfInfoSubmitBtn:pressed,
QPushButton#selfInfoEditBtn:pressed,
