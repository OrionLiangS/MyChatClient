}

/* 设置名字显示样式 */
QLabel#AvatarItem_nameLabel{
color:#9e9e9e;
    
    /* 🔥 新增：显式指定小字体，覆盖全局的 14px */
    font-size: 12px;  /* 建议用 10px 或 11px，5px 太小看不清，且有些屏幕不支持 */
    
    /* 确保背景透明，防止遮挡 */
    background: transparent; 
    border: none;}


/* 1. 基础样式 (清除所有干扰) */
QPushButton#detailsPageAddFriendBtn, 
QPushButton#detailsPageRemoveFriendBtn {
    border: none;           /* 关掉代码边框 */
    background: transparent;/* 背景透明 */
    icon: none;             /* 关掉 icon 属性，防止图标重复显示 */
    qproperty-icon: none;   /* 确保彻底关掉图标 */
}
/* ========================================================
   添加按钮 (Add)
   ======================================================== */

/* 正常状态 */
QPushButton#detailsPageAddFriendBtn {
