/* 1. 基础样式 (正确) */
QCheckBox#chooseFriendCheckBox {
    spacing: 8px;
    color: #333333;
    font-size: 14px;
    background: transparent;
}



/* 3. 未选中状态 - 直接在 indicator 后面加伪状态 */
QCheckBox#chooseFriendCheckBox::indicator:unchecked {
    width: 20px;
    height: 20px;
    image: url(:/resource/image/unchecked.png);
}

/* 4. 选中状态 */
QCheckBox#chooseFriendCheckBox::indicator:checked {
    width: 18px;
    height: 18px;
    image: url(:/resource/image/checked.png);
}

