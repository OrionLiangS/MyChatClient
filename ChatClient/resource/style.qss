/* ========================================================
   全局样式
   ======================================================== */
QWidget {
    font-family: "Microsoft YaHei"; /* 全局字体: 微软雅黑 */
    font-size: 14px;                /* 全局字号 */
}

/* ========================================================
   主窗口区域 (MainWidget)
   ======================================================== */
/* 主窗口圆角 */
QWidget#MainWidget {
    border-radius: 10px;
}

/* 左侧侧边栏: 深灰色背景 + 右侧分割线 */
QWidget#leftWindow {
    background-color: #ECECEC; 
    border: none; 
    border-right: 1px solid #D5D5D5;
}

/* 中间列表栏: 浅白色背景 + 右侧分割线 */
QWidget#midWindow {
    background-color: #F7F7F7; 
    border: none; 
    border-right: 1px solid #D5D5D5;
}

/* 右侧聊天栏: 浅灰色背景 */
QWidget#rightWindow {
    background-color: #EDEDED; 
    border: none;
}

/* ========================================================
   左侧按钮组 (头像 & 标签页)
   ======================================================== */
/* 用户头像按钮 */
QPushButton#userAvatar {
    border: none; 
    margin: 0px; 
    padding: 0px;
    background-size: 100% 100%; /* 图片填满 */
    border-radius: 5px;         /* 圆角 */
}

/* 侧边栏三大金刚: 会话、好友、申请 */
QPushButton#sessionTab,
QPushButton#friendTab,
QPushButton#applyTab {
    border: none;
    background-color: transparent; /* 平时透明 */
    border-radius: 5px;
    margin: 0px 0px;
}

/* 鼠标悬停时的反馈 (微微变深) */
QPushButton#sessionTab:hover,
QPushButton#friendTab:hover,
QPushButton#applyTab:hover {
    background-color: #DCDBDB; 
}

/* ========================================================
   分割器样式 (Splitter)
   ======================================================== */
/* 分割器主体 */
QSplitter#mainSplitter {
    border: none;
}

/* 分割器把手 (透明，不可见但可拖动) */
QSplitter#mainSplitter::handle {
    background-color: transparent;
}

/* ========================================================
   中间窗口区域组件 (搜索 & 列表)
   ======================================================== */
/* 搜索栏背景容器 */
QWidget#searchWidget {
    background:transparent;
}

/* 搜索输入框 */
QLineEdit#searchEdit {
    border: none;
    border-radius: 5px;
    background-color: #EAEAEA; /* 输入框底色偏灰 */
    font-size: 15px;
    font-family: "华文楷体";
}

/* 搜索框获得焦点时变亮 (纯白) */
QLineEdit#searchEdit:focus {
    background-color: #FFFFFF;
}

/* 添加好友按钮 (+) */
QPushButton#addFriendBtn {
    border: none;
    margin: 0px;
    border-radius: 5px;
    background-color: #EAEAEA; /* 与搜索框同色 */
}

/* 添加好友按钮悬停 */
QPushButton#addFriendBtn:hover {
    background-color: #E3E3E3;
}

